--- /dev/null
+++ b/servers/rendering/renderer_rd/environment/rt_cpu_profile.h
@@ -0,0 +1,33 @@
+#pragma once
+#include "core/os/os.h"
+#include "core/string/print_string.h"
+namespace RTCPU {
+enum Part { SHADOW_COLLECT, GI_COLLECT, SHADOW_SCENE, GI_SCENE, GI_LOOP, SHADOW_GEOMETRY, GI_GEOMETRY, SKIN_REFRESH, NEW_BLAS, MATERIAL_CONTEXT, MATERIAL_END, BUFFER_ADDRESS, BUFFER_UPLOAD, GI_TLAS, SHADOW_TLAS, EMITTER_UPDATE, COUNT };
+inline const char *names[] = { "shadow_collect", "gi_collect", "shadow_scene", "gi_scene", "gi_loop", "shadow_geometry", "gi_geometry", "skin_refresh", "new_blas", "material_context", "material_end", "buffer_address", "buffer_upload", "gi_tlas", "shadow_tlas", "emitter_update" };
+inline bool active = false;
+inline uint64_t serial = 0, elapsed[COUNT] = {}, calls[COUNT] = {};
+struct Scope {
+ Part part; uint64_t start; bool running;
+ Scope(Part p) : part(p), start(active ? OS::get_singleton()->get_ticks_usec() : 0), running(active) {}
+ void stop() { if (running) { elapsed[part] += OS::get_singleton()->get_ticks_usec() - start; calls[part]++; running = false; } }
+ ~Scope() { stop(); }
+};
+template<class F> auto measure(Part p, F f) { Scope s(p); return f(); }
+struct Session {
+ uint64_t start;
+ Session() {
+  static const bool enabled = OS::get_singleton()->get_environment("GODOT_RT_CPU_PROFILE") == "1";
+  active = enabled && (++serial % 8 == 0);
+  for (int i=0;i<COUNT;i++) { elapsed[i]=0; calls[i]=0; }
+  start = active ? OS::get_singleton()->get_ticks_usec() : 0;
+ }
+ ~Session() {
+  if (!active) { return; }
+  uint64_t total = OS::get_singleton()->get_ticks_usec() - start;
+  String line = "CPU_DETAIL {\"frame\":" + itos(serial) + ",\"total_us\":" + itos(total);
+  for (int i=0;i<COUNT;i++) { line += ",\"" + String(names[i]) + "_us\":" + itos(elapsed[i]) + ",\"" + String(names[i]) + "_calls\":" + itos(calls[i]); }
+  active = false;
+  print_line(line + "}");
+ }
+};
+}
