config_version=5

[application]
config/name="AMD GI binding lifetime fixture"
config/features=PackedStringArray("4.8", "Forward Plus")

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/vsync/vsync_mode=0

[rendering]
renderer/rendering_method="forward_plus"
rendering_device/driver.windows="vulkan"
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/raytraced_shadows/enabled=true
lights_and_shadows/raytraced_shadows/directional/enabled=true
global_illumination/amd_gi/enabled=true
global_illumination/amd_gi/cache_bucket_exponent=8
global_illumination/amd_gi/probe_spacing=16
streamline/enabled=false
